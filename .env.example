APP_NAME="Athanasius Scouts Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Permission matrix. false = keep existing RoleName checkAuth gates.
# After migrate + `php artisan permissions:seed`, set true to enforce the matrix.
PERMISSIONS_ENFORCE=false

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shamandora
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
# Production: CACHE_DRIVER=redis and SESSION_DRIVER=redis after redis-server is up.
# See context/redis.md. Do not flip these locally unless Redis is running.
SESSION_LIFETIME=120
# Production HTTPS: omit this key (config defaults Secure when APP_ENV=production).
# Local HTTP: SESSION_SECURE_COOKIE=false
# Do not set SESSION_DOMAIN unless you must share cookies across www + apex.
# Canonical host redirect keeps sessions on APP_URL's host instead.
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Live attendance (optional websocket). Leave null to use 10s polling only.
# For Soketi/Pusher-compatible server: BROADCAST_DRIVER=pusher
BROADCAST_DRIVER=null
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# After deploy for reservation QR attendance:
# 1) php artisan migrate
# 2) restart queue worker (auto-send QR after first payment)
# 3) restart WhatsApp bridge (image send)
# 4) optional: run Soketi/Pusher and set BROADCAST_DRIVER=pusher for live websockets

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=

JWT_SECRET=

WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000/send
WHATSAPP_BRIDGE_TOKEN=
WHATSAPP_SEND_QR=false

GOOGLE_DRIVE_CREDENTIALS=storage/app/google-drive-credentials.json
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_DRIVE_SERVICE_JSON=google-drive-service.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=

FIREBASE_CREDENTIALS=storage/app/firebase.json

L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000

SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=

# Optional: unlock /health?token=… details (failed_jobs, release, log_channel)
HEALTH_TOKEN=

# Event Program AI (Gemini free tier)
GEMINI_API_KEY=
EVENT_PROGRAM_AI_MODEL=gemini-2.5-flash

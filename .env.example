APP_NAME="Athanasius Scouts Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shamandora
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BREVO_API_KEY=

JWT_SECRET=

WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000/send
WHATSAPP_BRIDGE_TOKEN=

GOOGLE_DRIVE_CREDENTIALS=storage/app/google-drive-credentials.json
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_DRIVE_SERVICE_JSON=google-drive-service.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=

FIREBASE_CREDENTIALS=storage/app/firebase.json

L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000

SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=

# Optional: unlock /health?token=… details (failed_jobs, release, log_channel)
HEALTH_TOKEN=

# Copy to loadtests/k6.env and fill in. Never commit k6.env.
#   cp loadtests/k6.env.example loadtests/k6.env

BASE_URL=http://127.0.0.1:8000

# Dedicated load-test staff account (PersonID + password). Prefer Khadem
# scoped to one sector — not SuperAdmin, not a real person's daily login.
PERSON_ID=
PASSWORD=

# Optional. If empty, setup() picks the first SeasonEventID from
# GET /api/attendance/events?person_id={PERSON_ID}.
SEASON_EVENT_ID=

# Optional extra web sessions (staggered 16s apart to stay under login
# throttle:5,1). 1 = shared cookie (file-session lock contention). 5 is a
# better staff simulation for baseline. Max 20.
WEB_SESSIONS=1

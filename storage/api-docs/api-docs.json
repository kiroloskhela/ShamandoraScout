        "/api/attendance/events": {
            "get": {
                "tags": [
                    "Attendance"
                ],
                "summary": "Get seasons/events or events by season",
                "description": "If person_id is provided, returns seasons with events for that person (only if person_id matches authenticated user). Otherwise requires season_id and returns events for that season for the authenticated user.",
                "operationId": "attendanceEvents",
                "parameters": [
                    {
                        "name": "person_id",
                        "in": "query",
                        "description": "Person ID (must match authenticated user). If provided, season_id is ignored.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 55
                        }
                    },
                    {
                        "name": "season_id",
                        "in": "query",
                        "description": "Season ID (required if person_id not provided).",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 2024
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "oneOf": [
                                        {
                                            "properties": {
                                                "ok": {
                                                    "type": "boolean",
                                                    "example": true
                                                },
                                                "seasons": {
                                                    "type": "array",
                                                    "items": {
                                                        "properties": {
                                                            "SeasonID": {
                                                                "type": "integer",
                                                                "example": 1
                                                            },
                                                            "SeasonName": {
                                                                "type": "string",
                                                                "example": "Season A"
                                                            },
                                                            "SeasonYear": {
                                                                "type": "integer",
                                                                "example": 2025
                                                            },
                                                            "events": {
                                                                "type": "array",
                                                                "items": {
                                                                    "properties": {
                                                                        "SeasonEventID": {
                                                                            "type": "integer",
                                                                            "example": 999
                                                                        },
                                                                        "EventID": {
                                                                            "type": "integer",
                                                                            "example": 10
                                                                        },
                                                                        "EventName": {
                                                                            "type": "string",
                                                                            "example": "Weekly Meeting"
                                                                        },
                                                                        "EventStartDate": {
                                                                            "type": "string",
                                                                            "format": "date-time",
                                                                            "example": "2025-09-01 18:00:00"
                                                                        },
                                                                        "EventEndDate": {
                                                                            "type": "string",
                                                                            "format": "date-time",
                                                                            "example": "2025-09-01 20:00:00"
                                                                        }
                                                                    },
                                                                    "type": "object"
                                                                }
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        },
                                        {
                                            "properties": {
                                                "ok": {
                                                    "type": "boolean",
                                                    "example": true
                                                },
                                                "events": {
                                                    "type": "array",
                                                    "items": {
                                                        "properties": {
                                                            "SeasonEventID": {
                                                                "type": "integer",
                                                                "example": 999
                                                            },
                                                            "SeasonID": {
                                                                "type": "integer",
                                                                "example": 2024
                                                            },
                                                            "EventID": {
                                                                "type": "integer",
                                                                "example": 10
                                                            },
                                                            "EventName": {
                                                                "type": "string",
                                                                "example": "Weekly Meeting"
                                                            },
                                                            "EventStartDate": {
                                                                "type": "string",
                                                                "format": "date-time",
                                                                "example": "2025-09-01 18:00:00"
                                                            },
                                                            "EventEndDate": {
                                                                "type": "string",
                                                                "format": "date-time",
                                                                "example": "2025-09-01 20:00:00"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },

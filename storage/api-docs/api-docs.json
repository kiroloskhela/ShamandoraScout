            "post": {
                "tags": [
                    "Custody"
                ],
                "summary": "Create custody request",
                "description": "Creates a new custody request with items. No duplicate inventory items allowed.",
                "operationId": "custodyCreateRequest",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "date_from",
                                    "date_to",
                                    "items"
                                ],
                                "properties": {
                                    "date_from": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-01-21"
                                    },
                                    "date_to": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-01-22"
                                    },
                                    "qetaa_id": {
                                        "type": "integer",
                                        "example": 1,
                                        "nullable": true
                                    },
                                    "event_type_id": {
                                        "type": "integer",
                                        "example": 2,
                                        "nullable": true
                                    },
                                    "user_note": {
                                        "type": "string",
                                        "example": "Need items for event",
                                        "nullable": true
                                    },
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "required": [
                                                "inventory_id",
                                                "qty"
                                            ],
                                            "properties": {
                                                "inventory_id": {
                                                    "type": "integer",
                                                    "example": 5
                                                },
                                                "qty": {
                                                    "type": "integer",
                                                    "minimum": 1,
                                                    "example": 2
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "minItems": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "ok": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Custody request created"
                                        },
                                        "RequestID": {
                                            "type": "integer",
                                            "example": 123
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
